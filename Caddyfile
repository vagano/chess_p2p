{$DOMAIN} {
	# ── Backend routes (evaluated first, in order) ──

	handle /ws/* {
		reverse_proxy backend:8080
	}

	handle /signaling {
		reverse_proxy backend:8080
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /health {
		reverse_proxy backend:8080
	}

	handle /bot/* {
		reverse_proxy backend:8080
	}

	# ── Frontend SPA (everything else) ──

	handle {
		root * /srv

		# config.js — no cache (runtime-injected)
		@configjs path /config.js
		header @configjs Cache-Control "no-store, no-cache, must-revalidate"

		# Static assets — long cache
		@static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
		header @static Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}

	# ── Security headers ──
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode gzip
}
