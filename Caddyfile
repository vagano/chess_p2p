{$DOMAIN} {
	# ── CRDT Server: y-websocket (hocuspocus) ──
	handle_path /ws/* {
		reverse_proxy crdt-server:3000 {
			flush_interval -1
			transport http {
				versions 1.1
			}
		}
	}

	# ── Backend: WebRTC signaling ──
	handle /signaling {
		reverse_proxy backend:8080 {
			flush_interval -1
			transport http {
				versions 1.1
			}
		}
	}

	# ── Backend: REST API ──
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /health {
		reverse_proxy backend:8080
	}

	handle /bot/* {
		reverse_proxy backend:8080
	}

	# Normalize /tma → /tma/ without external redirect (Telegram WebView issue)
	@tma_exact path /tma
	rewrite @tma_exact /tma/

	# ── TMA SPA (Telegram Mini App) ──
	handle_path /tma/* {
		root * /srv/tma

		@static {
			path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
			not path /config.js
		}
		header @static Cache-Control "public, max-age=31536000, immutable"

		@configjs path /config.js
		header @configjs Cache-Control "no-store, no-cache, must-revalidate"

		try_files {path} /index.html
		file_server
		encode gzip
	}

	# ── Web SPA (everything else) ──
	handle {
		root * /srv/web

		@static_web {
			path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
			not path /config.js
		}
		header @static_web Cache-Control "public, max-age=31536000, immutable"

		@configjs_web path /config.js
		header @configjs_web Cache-Control "no-store, no-cache, must-revalidate"

		try_files {path} /index.html
		file_server
		encode gzip
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
