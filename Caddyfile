{$DOMAIN} {
	# ── Backend: y-websocket (CRDT sync) ──
	handle /ws/* {
		reverse_proxy backend:8080 {
			flush_interval -1
			transport http {
				versions 1.1
			}
		}
	}

	# ── Backend: WebRTC signaling ──
	handle /signaling {
		reverse_proxy backend:8080 {
			flush_interval -1
			transport http {
				versions 1.1
			}
		}
	}

	# ── Backend: REST API ──
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /health {
		reverse_proxy backend:8080
	}

	handle /bot/* {
		reverse_proxy backend:8080
	}

	# ── Frontend SPA (everything else) ──
	handle {
		root * /srv

		@configjs path /config.js
		header @configjs Cache-Control "no-store, no-cache, must-revalidate"

		@static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
		header @static Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
		encode gzip
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
