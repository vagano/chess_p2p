{$DOMAIN} {
	# ── WebSocket: y-websocket ──
	@ws path /ws/*
	reverse_proxy @ws backend:8080

	# ── WebSocket: y-webrtc signaling ──
	@signaling path /signaling
	reverse_proxy @signaling backend:8080

	# ── REST API ──
	@api path /api/*
	reverse_proxy @api backend:8080

	# ── Health check ──
	@health path /health
	reverse_proxy @health backend:8080

	# ── Telegram Bot webhook ──
	@webhook path /bot/*
	reverse_proxy @webhook backend:8080

	# ── config.js — no cache (runtime-injected) ──
	@configjs path /config.js
	header @configjs Cache-Control "no-store, no-cache, must-revalidate"

	# ── Static assets — long cache ──
	@static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
	header @static Cache-Control "public, max-age=31536000, immutable"

	# ── SPA: serve files, fallback to index.html ──
	root * /srv
	try_files {path} /index.html
	file_server

	# ── Security headers ──
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode gzip
}
